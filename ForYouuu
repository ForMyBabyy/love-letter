<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>With You ❤️</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
    font-family: Georgia, "Times New Roman", serif;
    color: white;
    overflow-x: hidden;
    background:
        radial-gradient(circle at 20% 20%, rgba(190, 70, 255, .35), transparent 25%),
        radial-gradient(circle at 80% 30%, rgba(255, 70, 180, .25), transparent 28%),
        radial-gradient(circle at 50% 80%, rgba(90, 50, 220, .35), transparent 35%),
        #080014;
}

/* Stars */
body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background-image:
        radial-gradient(white 1px, transparent 1px),
        radial-gradient(rgba(255,255,255,.7) 1px, transparent 1px);
    background-size: 90px 90px, 140px 140px;
    background-position: 10px 20px, 50px 70px;
    opacity: .55;
}

/* Music button */
.music-button {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 10;
    border: 1px solid rgba(255,255,255,.35);
    border-radius: 30px;
    padding: 12px 18px;
    color: white;
    background: rgba(80, 20, 120, .65);
    backdrop-filter: blur(8px);
    box-shadow: 0 0 20px rgba(190, 80, 255, .45);
    cursor: pointer;
    font-size: 14px;
}

.music-button:hover {
    transform: scale(1.04);
}

/* Main */
.container {
    position: relative;
    z-index: 1;
    width: min(1000px, 92%);
    margin: auto;
    padding: 80px 0 70px;
    text-align: center;
}

h1 {
    font-size: clamp(42px, 8vw, 78px);
    margin-bottom: 10px;
    text-shadow: 0 0 25px #e28aff;
}

.subtitle {
    font-size: clamp(17px, 3vw, 24px);
    opacity: .9;
    margin-bottom: 45px;
}

/* Glowing heart */
.heart {
    width: 110px;
    height: 110px;
    margin: 0 auto 50px;
    position: relative;
    transform: rotate(-45deg);
    background: #ff4fa3;
    box-shadow:
        0 0 25px #ff4fa3,
        0 0 60px rgba(255, 79, 163, .8);
    animation: heartbeat 1.5s infinite;
}

.heart::before,
.heart::after {
    content: "";
    width: 110px;
    height: 110px;
    position: absolute;
    border-radius: 50%;
    background: #ff4fa3;
}

.heart::before {
    top: -55px;
    left: 0;
}

.heart::after {
    top: 0;
    left: 55px;
}

@keyframes heartbeat {
    0%, 100% { transform: rotate(-45deg) scale(1); }
    50% { transform: rotate(-45deg) scale(1.12); }
}

/* Photos */
.photos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin: 30px 0 55px;
}

.photo {
    min-height: 210px;
    border-radius: 18px;
    border: 1px solid rgba(255,255,255,.2);
    background:
        linear-gradient(145deg, rgba(255,255,255,.12), rgba(255,255,255,.03));
    box-shadow: 0 10px 35px rgba(0,0,0,.35);
    overflow: hidden;
    display: flex;
    align-items: end;
    justify-content: center;
    padding: 18px;
    transition: .3s;
}

.photo:hover {
    transform: translateY(-7px);
    box-shadow: 0 0 30px rgba(220,100,255,.35);
}

/* Replace these backgrounds with your own photos if you want */
.photo:nth-child(1) {
    background-image:
        linear-gradient(rgba(20,0,40,.15), rgba(20,0,40,.65)),
        url("photo1.jpg");
    background-size: cover;
    background-position: center;
}

.photo:nth-child(2) {
    background-image:
        linear-gradient(rgba(20,0,40,.15), rgba(20,0,40,.65)),
        url("photo2.jpg");
    background-size: cover;
    background-position: center;
}

.photo:nth-child(3) {
    background-image:
        linear-gradient(rgba(20,0,40,.15), rgba(20,0,40,.65)),
        url("photo3.jpg");
    background-size: cover;
    background-position: center;
}

.photo:nth-child(4) {
    background-image:
        linear-gradient(rgba(20,0,40,.15), rgba(20,0,40,.65)),
        url("photo4.jpg");
    background-size: cover;
    background-position: center;
}

.photo span {
    font-size: 15px;
    text-shadow: 0 2px 8px black;
}

/* Message */
.message {
    max-width: 720px;
    margin: auto;
    padding: 35px 25px;
    border-radius: 25px;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.14);
    backdrop-filter: blur(10px);
    box-shadow: 0 0 40px rgba(150,70,255,.18);
}

.message h2 {
    font-size: 32px;
    margin-bottom: 15px;
}

.message p {
    line-height: 1.8;
    font-size: 18px;
    opacity: .92;
}

/* Floating words */
.floating {
    position: fixed;
    pointer-events: none;
    font-size: 13px;
    opacity: .65;
    animation: float 7s infinite ease-in-out;
    z-index: 0;
}

.f1 { left: 8%; top: 25%; }
.f2 { right: 8%; top: 45%; animation-delay: 2s; }
.f3 { left: 15%; bottom: 15%; animation-delay: 4s; }
.f4 { right: 15%; bottom: 25%; animation-delay: 1s; }

@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
}

@media (max-width: 700px) {
    .photos {
        grid-template-columns: repeat(2, 1fr);
    }

    .photo {
        min-height: 180px;
    }

    .heart {
        width: 80px;
        height: 80px;
    }

    .heart::before,
    .heart::after {
        width: 80px;
        height: 80px;
    }

    .heart::before { top: -40px; }
    .heart::after { left: 40px; }

    .music-button {
        top: 12px;
        right: 12px;
    }
}
</style>
</head>

<body>

<button class="music-button" onclick="toggleMusic()">🎵 Play His Voice</button>

<audio id="bgMusic" loop>
    <source src="his_voice_cleaned.mp3" type="audio/mpeg">
</audio>

<div class="floating f1">I LOVE YOU ❤️</div>
<div class="floating f2">MY BABY ❤️</div>
<div class="floating f3">I LOVE YOU ❤️</div>
<div class="floating f4">MY LOVE ❤️</div>

<main class="container">

    <h1>With You</h1>
    <p class="subtitle">My universe makes sense with you. ✨</p>

    <div class="heart"></div>

    <section class="photos">
        <div class="photo">
            <span>Every moment with you is my favorite. ❤️</span>
        </div>

        <div class="photo">
            <span>You are my happiness. 💕</span>
        </div>

        <div class="photo">
            <span>My favorite person. 🌙</span>
        </div>

        <div class="photo">
            <span>Forever with you. ✨</span>
        </div>
    </section>

    <section class="message">
        <h2>In My Heart ❤️</h2>
        <p>
            Happy Monthsary Baby, I love you! 🌌❤️
        </p>
    </section>

</main>

<script>
const music = document.getElementById("bgMusic");
const button = document.querySelector(".music-button");

function toggleMusic() {
    if (music.paused) {
        music.play();
        button.textContent = "⏸ Pause His Voice";
    } else {
        music.pause();
        button.textContent = "🎵 Play His Voice";
    }
}
</script>

</body>
</html>
